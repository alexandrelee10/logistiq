// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`



generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum USERROLE {
  ADMIN
  MANAGER
  WAREHOUSE_STAFF
  PURCHASING
  ACCOUNTING
  VIEWER
}

enum PurchaseOrderStatus {
  awaiting_approval
  approved
  cancelled
  draft
  submitted
  received
  partially_received
  confirmed
}

enum PaymentMethod {
  cash
  check
  credit_card
  wire_transfer
  ach
  other
}

enum InviteStatus {
  pending
  accepted
  revoked
}

model User {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String   @unique
  phoneNumber String   @unique
  password    String
  role        USERROLE

  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Session {
  id     String @id @default(cuid())
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique

  createdAt DateTime @default(now())

  users User[]

  products Product[]

  warehouses Warehouse[]

  suppliers Supplier[]

  purchaseOrders PurchaseOrder[]

  customers Customer[]

  salesOrders SalesOrder[]

  orderSequences OrderSequence[]

  invites Invite[]
}

model Product {
  id String @id @default(cuid())

  organizationId String
  organization Organization @relation(references: [id], fields: [organizationId])

  sku String
  name String
  reorderPoint Int @default(0) // Fix later
  attributes Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, sku])
  inventoryItems InventoryItem[]
  inventoryRecords InventoryRecord[]
  purchaseOrderLines PurchaseOrderLine[]
  salesOrderLines SalesOrderLine[]
}

model Warehouse {
  id String @id @default(cuid())
  
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])

  name String
  code String

  createdAt DateTime @default(now())
  
  @@unique([organizationId, code])

  inventoryItems InventoryItem[]
  inventoryRecords InventoryRecord[]
}

model InventoryItem {
  id String @id @default(cuid())

  productId String
  product Product @relation(fields: [productId], references: [id])

  warehouseId String
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  quantity Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([productId, warehouseId])

}

model InventoryRecord {
  id String @id @default(cuid())

  productId String
  product Product @relation(fields: [productId], references: [id])

  warehouseId String
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  delta Int // + means added, - means removed
  reason String? // List why delta was created
  userId String?

  createdAt DateTime @default(now())
}

model Supplier {
  id String @id @default(cuid())

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])

  name String
  email String?
  phone String?

  createdAt DateTime @default(now())


  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id String @id @default(cuid())
  
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  
  supplierId String
  supplier Supplier @relation(fields: [supplierId], references: [id])
  poNumber String @unique

  status PurchaseOrderStatus @default(awaiting_approval)
 
  createdAt DateTime @default(now())
  
  purchaseOrderLines PurchaseOrderLine[]
}

// Each order line in a purchase order
model PurchaseOrderLine {
  id String @id @default(cuid())

  purchaseOrderId String
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  productId String
  product Product @relation(fields: [productId], references: [id])

  quantityOrdered Int
  quantityReceived Int @default(0)
  unitCost Decimal? @db.Decimal(10,2) // store an exact decimal number with up to 10 total digits, 2 of which are after the decimal point
}

model Customer {
  id String @id @default(cuid())

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])

  name String
  email String?
  phone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  salesOrders SalesOrder[]
}

model SalesOrder {
  id String @id @default(cuid())

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])

  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  soNumber String @unique

  status String @default("draft")
  dueDate DateTime?
  amountPaid Decimal @default(0) @db.Decimal(10,2)


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesOrderLines SalesOrderLine[]

  payments Payment[]
}

model SalesOrderLine {
  id String @id @default(cuid())

  salesOrderId String
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])

  productId String
  product Product @relation(fields: [productId], references: [id])

  quantityOrdered Int
  quantityFufilled Int @default(0)
  unitPrice Decimal @db.Decimal(10,2)
}

model OrderSequence {
  id String @id @default(cuid())
  
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type String
  lastNumber Int @default(1000)

  @@unique([organizationId, type])
}

model Payment {
  id String @id @default(cuid())

  salesOrderId String
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])

  amount Decimal @db.Decimal(10,2)
  method PaymentMethod?
  userId String?

  createdAt DateTime @default(now())
}

model Invite {

id String @id @default(cuid())

organizationId String
organization Organization @relation(fields: [organizationId], references: [id])

email String
role USERROLE
token String @unique
status InviteStatus 

invitedByUserId String
expiresAt DateTime
createdAt DateTime @default(now())

@@unique([organizationId, email]) // Ensures same organization cant spam the same user

}